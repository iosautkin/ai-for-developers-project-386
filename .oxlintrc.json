{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-perf", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "off"
  },
  "ignorePatterns": [
    "**/generated/**",
    "**/dist/**",
    "**/storybook-static/**",
    "**/.playwright-bdd/**"
  ]
}
